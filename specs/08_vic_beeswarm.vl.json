{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Beeswarm / jittered strip plot: every one of Victoria's 79 councils is a single dot placed by its facilities per 1,000 people, with a small random vertical jitter to stop dots overlapping. Each dot is sized by population, which reveals the twist: the councils with the highest per-person access are the smallest by population. The three rural leaders are labelled. Sources: Victorian sport facilities dataset + ABS population.",
  "width": "container",
  "height": 360,
  "data": { "url": "data/vic_lga.json" },
  "config": {
    "font": "Archivo, sans-serif",
    "view": { "stroke": null },
    "axis": { "labelColor": "#4a463c", "titleColor": "#4a463c" },
    "legend": { "labelColor": "#4a463c", "titleColor": "#4a463c" }
  },
  "transform": [
    { "calculate": "random()", "as": "jitter" },
    { "calculate": "datum.population >= 200000 ? 'Over 200k' : (datum.population >= 50000 ? '50k to 200k' : 'Under 50k')", "as": "pop_band" }
  ],
  "layer": [
    {
      "mark": { "type": "circle", "opacity": 0.65, "stroke": "#143C28", "strokeWidth": 0.4 },
      "encoding": {
        "x": {
          "field": "facilities_per_1k",
          "type": "quantitative",
          "title": "Facilities per 1,000 people  →  better per-person access",
          "axis": { "grid": true, "gridColor": "#efe9dc" }
        },
        "y": { "field": "jitter", "type": "quantitative", "axis": null, "scale": { "domain": [-0.05, 1.05] } },
        "size": {
          "field": "pop_band",
          "type": "ordinal",
          "title": "Population",
          "sort": ["Under 50k", "50k to 200k", "Over 200k"],
          "scale": { "domain": ["Under 50k", "50k to 200k", "Over 200k"], "range": [60, 280, 700] },
          "legend": null
        },
        "color": { "value": "#2C7A52" },
        "tooltip": [
          { "field": "lga", "type": "nominal", "title": "Council" },
          { "field": "facilities_per_1k", "type": "quantitative", "title": "Facilities per 1,000" },
          { "field": "population", "type": "quantitative", "title": "Population", "format": "," }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.facilities_per_1k >= 12" }],
      "mark": { "type": "text", "align": "center", "dy": -14, "fontSize": 10, "fontWeight": 700, "color": "#143C28" },
      "encoding": {
        "x": { "field": "facilities_per_1k", "type": "quantitative" },
        "y": { "field": "jitter", "type": "quantitative" },
        "text": { "field": "lga", "type": "nominal" }
      }
    }
  ]
}
