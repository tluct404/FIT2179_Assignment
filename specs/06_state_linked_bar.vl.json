{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Custom combined idiom: a choropleth map linked to a ranked bar chart of estimated weekly-active people. Click a state on the map (or a bar) to highlight it in both views; click empty space to reset. The two views are coordinated through a shared point-selection parameter on the state field. Sources: ABS ERP June 2024 + AusPlay national weekly rate (66%); geometry: rowanhogan/australian-states.",
  "params": [
    {
      "name": "sel",
      "select": { "type": "point", "fields": ["state"] },
      "value": []
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "view": { "stroke": null },
    "axis": { "labelColor": "#46566b", "titleColor": "#46566b" },
    "legend": { "labelColor": "#46566b", "titleColor": "#46566b" }
  },
  "hconcat": [
    {
      "width": 360,
      "height": 320,
      "title": { "text": "Click a state to highlight", "fontSize": 12, "color": "#6b7a8d", "fontWeight": 500 },
      "projection": {
        "type": "conicEqualArea",
        "rotate": [-134, 0],
        "parallels": [-18, -36],
        "center": [0, -27]
      },
      "data": {
        "url": "geo/au-states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": { "url": "data/state_population.json" },
            "key": "state",
            "fields": ["state", "abbr", "est_active", "population"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "est_active",
          "type": "quantitative",
          "title": "Est. weekly-active",
          "scale": { "scheme": "greens" },
          "legend": { "format": "~s", "orient": "bottom" }
        },
        "opacity": {
          "condition": { "param": "sel", "value": 1 },
          "value": 0.3
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / Territory" },
          { "field": "est_active", "type": "quantitative", "title": "Est. weekly-active", "format": "," }
        ]
      }
    },
    {
      "width": 320,
      "height": 320,
      "title": { "text": "Estimated weekly-active people", "fontSize": 12, "color": "#6b7a8d", "fontWeight": 500 },
      "data": { "url": "data/state_population.json" },
      "mark": { "type": "bar", "cornerRadiusEnd": 3, "height": 24 },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": { "field": "est_active", "order": "descending" },
          "title": null,
          "axis": { "labelFontSize": 11 }
        },
        "x": {
          "field": "est_active",
          "type": "quantitative",
          "title": "People (millions)",
          "axis": { "format": "~s" }
        },
        "color": {
          "condition": { "param": "sel", "value": "#2E8B57" },
          "value": "#cdd6cf"
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / Territory" },
          { "field": "est_active", "type": "quantitative", "title": "Est. weekly-active", "format": "," }
        ]
      }
    }
  ]
}
