{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "KPI strip: three nested headline rates of Australian adult activity (yearly, weekly, three-plus times a week). Text marks are used because the goal is to read three exact figures quickly, not to compare lengths. Source: AusPlay (Australian Sports Commission).",
  "width": "container",
  "height": 150,
  "data": { "url": "data/national_headline.json" },
  "config": {
    "font": "Inter, sans-serif",
    "view": { "stroke": null }
  },
  "encoding": {
    "x": {
      "field": "order",
      "type": "ordinal",
      "axis": null,
      "scale": { "padding": 0.4 }
    }
  },
  "layer": [
    {
      "mark": { "type": "text", "fontSize": 58, "fontWeight": 800, "color": "#1F5F3A", "dy": -18, "font": "Poppins, sans-serif" },
      "encoding": { "text": { "field": "share", "type": "quantitative", "format": ".0f" } }
    },
    {
      "mark": { "type": "text", "fontSize": 22, "fontWeight": 800, "color": "#F2A900", "dy": -34, "dx": 44, "font": "Poppins, sans-serif" },
      "encoding": { "text": { "value": "%" } }
    },
    {
      "mark": { "type": "text", "fontSize": 13, "color": "#46566b", "dy": 34, "lineBreak": "|", "limit": 220 },
      "encoding": { "text": { "field": "metric", "type": "nominal" } }
    }
  ]
}
