{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart of the ten most-played organised sports in Australia by adult participants. A lollipop is used instead of a full bar to keep a high data-ink ratio while still encoding magnitude by position/length along a common scale. Sorted by rank so the leader (Swimming) reads first. Source: AusPlay (Australian Sports Commission).",
  "width": "container",
  "height": 360,
  "data": { "url": "data/top_sports.json" },
  "config": {
    "font": "Archivo, sans-serif",
    "axis": { "labelColor": "#4a463c", "titleColor": "#4a463c", "grid": false },
    "view": { "stroke": null }
  },
  "transform": [
    { "calculate": "datum.participants / 1000000", "as": "participants_m" },
    { "calculate": "format(datum.participants_m, '.2f') + 'M'", "as": "label" }
  ],
  "encoding": {
    "y": {
      "field": "sport",
      "type": "nominal",
      "sort": { "field": "rank", "order": "ascending" },
      "title": null,
      "axis": { "labelFontWeight": 600, "labelFontSize": 12 }
    },
    "x": {
      "field": "participants_m",
      "type": "quantitative",
      "title": "Adult participants (millions)",
      "scale": { "domainMax": 4.3 },
      "axis": { "tickCount": 4 }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#d8d2c2", "strokeWidth": 2 },
      "encoding": { "x2": { "datum": 0 } }
    },
    {
      "mark": { "type": "circle", "size": 230, "color": "#2C7A52", "opacity": 1 },
      "encoding": {
        "tooltip": [
          { "field": "sport", "type": "nominal", "title": "Sport" },
          { "field": "participants", "type": "quantitative", "title": "Participants", "format": "," },
          { "field": "rank", "type": "ordinal", "title": "Rank" }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 10, "fontSize": 11, "fontWeight": 600, "color": "#4a463c" },
      "encoding": {
        "text": { "field": "label", "type": "nominal" }
      }
    },
    {
      "transform": [{ "filter": "datum.sport === 'Swimming'" }],
      "mark": { "type": "text", "align": "right", "dx": -14, "dy": -15, "fontSize": 10, "fontStyle": "italic", "fontWeight": 600, "color": "#143C28" },
      "encoding": {
        "text": { "value": "Beats soccer + tennis + basketball combined" }
      }
    }
  ]
}
