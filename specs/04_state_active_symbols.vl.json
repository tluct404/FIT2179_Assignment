{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of the estimated number of weekly-active people per state/territory. This is a DERIVED measure combining two sources: each state's resident population (ABS, June 2024) multiplied by AusPlay's national weekly-activity rate of 66%. Circle area encodes magnitude; a light base map provides geographic context. It shows that active Australians are concentrated where people live (NSW, VIC, QLD), motivating the per-person access question explored for Victoria below. Sources: ABS ERP June 2024 + AusPlay (ASC); geometry: rowanhogan/australian-states.",
  "width": "container",
  "height": 360,
  "config": {
    "font": "Archivo, sans-serif",
    "view": { "stroke": null },
    "legend": { "labelColor": "#4a463c", "titleColor": "#4a463c" }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0],
    "parallels": [-18, -36],
    "center": [0, -27]
  },
  "layer": [
    {
      "data": {
        "url": "geo/au-states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": { "type": "geoshape", "fill": "#efe9dc", "stroke": "#d8d2c2", "strokeWidth": 0.8 }
    },
    {
      "data": { "url": "data/state_population.json" },
      "transform": [
        { "calculate": "datum.est_active >= 4000000 ? 'Over 4 million' : (datum.est_active >= 1000000 ? '1 to 4 million' : 'Under 1 million')", "as": "size_band" }
      ],
      "mark": { "type": "circle", "color": "#2C7A52", "opacity": 0.8, "stroke": "#143C28", "strokeWidth": 1 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "size": {
          "field": "size_band",
          "type": "ordinal",
          "title": "Est. weekly-active people",
          "scale": {
            "domain": ["Under 1 million", "1 to 4 million", "Over 4 million"],
            "range": [700, 1700, 3200]
          }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / Territory" },
          { "field": "est_active", "type": "quantitative", "title": "Est. weekly-active people", "format": "," },
          { "field": "population", "type": "quantitative", "title": "Residents", "format": "," }
        ]
      }
    },
    {
      "data": { "url": "data/state_population.json" },
      "mark": { "type": "text", "fontSize": 9, "fontWeight": 700, "color": "#ffffff", "dy": 1 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "abbr", "type": "nominal" }
      }
    },
    {
      "data": { "values": [{ "lon": 133, "lat": -40.5 }] },
      "mark": { "type": "text", "fontSize": 11, "fontStyle": "italic", "fontWeight": 600, "color": "#4a463c", "lineBreak": "|" },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "value": "Most active adults live|in the populous south-east" }
      }
    }
  ]
}
