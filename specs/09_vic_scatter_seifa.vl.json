{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Equity scatterplot: each Victorian LGA plotted by socio-economic advantage (SEIFA decile, x) against facilities per 1,000 people (y, derived). A linear regression line summarises the relationship for a general audience without requiring statistical knowledge. Tests whether wealthier areas have more facilities per person. Requires seifa_irsd_decile in data/vic_lga.json. Sources: Victorian sport facilities dataset + ABS SEIFA 2021 + ABS population (see README).",
  "width": "container",
  "height": 360,
  "config": {
    "font": "Inter, sans-serif",
    "view": { "stroke": null },
    "axis": { "labelColor": "#46566b", "titleColor": "#46566b", "gridColor": "#eef1ee" }
  },
  "data": { "url": "data/vic_lga.json" },
  "transform": [{ "filter": "datum.seifa_irsd_decile !== null" }],
  "layer": [
    {
      "mark": { "type": "point", "filled": true, "color": "#2E8B57", "opacity": 0.7, "size": 70 },
      "encoding": {
        "x": {
          "field": "seifa_irsd_decile",
          "type": "quantitative",
          "title": "SEIFA decile  (1 = most disadvantaged  →  10 = least)",
          "scale": { "domain": [0.5, 10.5] },
          "axis": { "tickCount": 10 }
        },
        "y": {
          "field": "facilities_per_1k",
          "type": "quantitative",
          "title": "Facilities per 1,000 people"
        },
        "tooltip": [
          { "field": "lga", "type": "nominal", "title": "LGA" },
          { "field": "seifa_irsd_decile", "type": "ordinal", "title": "SEIFA decile" },
          { "field": "facilities_per_1k", "type": "quantitative", "title": "Facilities per 1,000" }
        ]
      }
    },
    {
      "mark": { "type": "line", "color": "#F2A900", "strokeWidth": 3 },
      "transform": [
        { "regression": "facilities_per_1k", "on": "seifa_irsd_decile" }
      ],
      "encoding": {
        "x": { "field": "seifa_irsd_decile", "type": "quantitative" },
        "y": { "field": "facilities_per_1k", "type": "quantitative" }
      }
    }
  ]
}
