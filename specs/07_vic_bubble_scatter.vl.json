{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bubble scatterplot of Victoria's 79 councils: socio-economic advantage (SEIFA) on the horizontal axis, facilities per 1,000 people on the vertical, each council sized by population in three bands, with a regression line. Combining the point, line and size channels shows two findings at once: the line slopes downward (wealthier areas have fewer facilities per person), and the largest councils sit low (the high per-person figures belong to tiny-population councils). Sources: Victorian sport facilities dataset + ABS SEIFA 2021 + ABS population.",
  "width": "container",
  "height": 360,
  "config": {
    "font": "Archivo, sans-serif",
    "view": { "stroke": null },
    "axis": { "labelColor": "#4a463c", "titleColor": "#4a463c", "gridColor": "#efe9dc" },
    "legend": { "labelColor": "#4a463c", "titleColor": "#4a463c" }
  },
  "data": { "url": "data/vic_lga.json" },
  "transform": [
    { "filter": "datum.seifa_irsd_decile !== null" },
    { "calculate": "datum.population >= 200000 ? 'Over 200k' : (datum.population >= 50000 ? '50k to 200k' : 'Under 50k')", "as": "pop_band" }
  ],
  "layer": [
    {
      "mark": { "type": "point", "filled": true, "color": "#2C7A52", "opacity": 0.6, "stroke": "#143C28", "strokeWidth": 0.5 },
      "encoding": {
        "x": {
          "field": "seifa_irsd_decile",
          "type": "quantitative",
          "title": "SEIFA decile  (1 = most disadvantaged, 10 = least)",
          "scale": { "domain": [0.5, 10.5] },
          "axis": { "tickCount": 10 }
        },
        "y": {
          "field": "facilities_per_1k",
          "type": "quantitative",
          "title": "Facilities per 1,000 people"
        },
        "size": {
          "field": "pop_band",
          "type": "ordinal",
          "title": "Population",
          "sort": ["Under 50k", "50k to 200k", "Over 200k"],
          "scale": { "domain": ["Under 50k", "50k to 200k", "Over 200k"], "range": [70, 300, 750] }
        },
        "tooltip": [
          { "field": "lga", "type": "nominal", "title": "Council" },
          { "field": "seifa_irsd_decile", "type": "ordinal", "title": "SEIFA decile" },
          { "field": "facilities_per_1k", "type": "quantitative", "title": "Facilities per 1,000" },
          { "field": "population", "type": "quantitative", "title": "Population", "format": "," }
        ]
      }
    },
    {
      "transform": [{ "regression": "facilities_per_1k", "on": "seifa_irsd_decile" }],
      "mark": { "type": "line", "color": "#DD9A2B", "strokeWidth": 3 },
      "encoding": {
        "x": { "field": "seifa_irsd_decile", "type": "quantitative" },
        "y": { "field": "facilities_per_1k", "type": "quantitative" }
      }
    }
  ]
}
