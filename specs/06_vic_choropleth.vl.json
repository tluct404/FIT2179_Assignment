{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Victoria zoom-in: choropleth of sport and recreation facilities per 1,000 residents by Local Government Area (a derived per-capita rate). Rural shires are far better supplied per person than fast-growing metro councils. Mercator projection. Sources: Victorian sport facilities dataset + ABS population; geometry: ABS ASGS 2023 (TopoJSON).",
  "width": "container",
  "height": 440,
  "config": {
    "font": "Archivo, sans-serif",
    "view": { "stroke": null },
    "legend": { "labelColor": "#4a463c", "titleColor": "#4a463c" }
  },
  "projection": { "type": "mercator" },
  "data": {
    "url": "geo/LGA_2023_VIC_GDA2020.json",
    "format": { "type": "topojson", "feature": "LGA_2023_AUST_GDA2020" }
  },
  "transform": [
    {
      "lookup": "properties.LGA_NAME23",
      "from": {
        "data": { "url": "data/vic_lga.json" },
        "key": "lga",
        "fields": ["facilities", "population", "facilities_per_1k"]
      }
    }
  ],
  "params": [
    { "name": "hoverLGA", "select": { "type": "point", "on": "pointerover", "clear": "pointerout" } }
  ],
  "mark": { "type": "geoshape", "stroke": "#ffffff" },
  "encoding": {
    "color": {
      "field": "facilities_per_1k",
      "type": "quantitative",
      "title": "Facilities per 1,000 people",
      "scale": { "scheme": "greens" }
    },
    "opacity": {
      "condition": { "param": "hoverLGA", "value": 1 },
      "value": 0.4
    },
    "stroke": {
      "condition": { "param": "hoverLGA", "empty": false, "value": "#143C28" },
      "value": "#ffffff"
    },
    "strokeWidth": {
      "condition": { "param": "hoverLGA", "empty": false, "value": 2 },
      "value": 0.5
    },
    "tooltip": [
      { "field": "properties.LGA_NAME23", "type": "nominal", "title": "Council" },
      { "field": "facilities", "type": "quantitative", "title": "Facilities", "format": "," },
      { "field": "population", "type": "quantitative", "title": "Population", "format": "," },
      { "field": "facilities_per_1k", "type": "quantitative", "title": "Per 1,000 people" }
    ]
  }
}
